// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  phone    String  @unique
  email    String? @unique
  name     String?
  role     Role    @default(USER)
  isActive Boolean @default(true)

  passwordHash    String
  sessions        Session[]
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerProfile         SellerProfile?
  customerProfile       CustomerProfile?
  sellerMember          SellerMember?
  sellerMemberAuditLogs SellerMemberAuditLog[]
}

model Session {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  refreshTokenHash String
  revokedAt        DateTime?
  expiresAt        DateTime

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  USER
  SELLER
  ADMIN
}

model SellerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName String

  invoiceTemplateId String   @default("default")
  baseCurrency      Currency @default(IRT)

  notifyInvoiceIssued       Boolean @default(true)
  notifyInvoiceStatusChange Boolean @default(true)
  notifyPaymentReminder     Boolean @default(true)
  notifyLowStock            Boolean @default(true)
  lowStockThreshold         Int     @default(5)

  warehouses       Warehouse[]
  products         Product[]
  productDiscounts ProductDiscount[]
  invoices         Invoice[]
  customers        SellerCustomer[]
  reminders        Reminder[]
  discountCodes    DiscountCode[]
  members          SellerMember[]
  memberAuditLogs  SellerMemberAuditLog[]
  bankAccounts     BankAccount[]
  shippingMethods  ShippingMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BankAccount {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name          String
  accountNumber String
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

model ShippingMethod {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name     String
  price    BigInt
  currency Currency @default(IRT)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

model SellerCustomer {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name  String?
  phone String
  notes String?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, phone])
  @@index([sellerId])
}

model CustomerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerMember {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  canInvoices  Boolean @default(true)
  canCustomers Boolean @default(true)
  canProducts  Boolean @default(false)
  canSettings  Boolean @default(false)
  canWarehouse Boolean @default(false)
  canReports   Boolean @default(false)

  warehouses SellerMemberWarehouse[]
  auditLogs  SellerMemberAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

model SellerMemberWarehouse {
  id             Int @id @default(autoincrement())
  sellerMemberId Int
  warehouseId    Int

  sellerMember SellerMember @relation(fields: [sellerMemberId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([sellerMemberId, warehouseId])
  @@index([warehouseId])
}

model SellerMemberAuditLog {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  memberId Int
  member   SellerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String
  method     String
  path       String
  statusCode Int?
  ipAddress  String?
  userAgent  String?
  meta       Json?

  createdAt DateTime @default(now())

  @@index([sellerId, memberId])
  @@index([memberId, createdAt])
}

model Warehouse {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name     String
  location String?

  inventories  Inventory[]
  invoices     Invoice[]
  memberAccess SellerMemberWarehouse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
}

model Product {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants  ProductVariant[]
  discounts ProductDiscount[]

  @@index([sellerId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String
  price      BigInt // store in minor units
  attributes Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories   Inventory[]
  invoiceItems  InvoiceItem[]
  discountCodes DiscountCode[]
  discounts     ProductDiscount[]

  @@unique([productId, sku])
}

model ProductDiscount {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  type  DiscountType
  value BigInt

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([productId])
  @@index([variantId])
}

model Inventory {
  id          Int @id @default(autoincrement())
  warehouseId Int
  variantId   Int

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int

  ledger InventoryLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, variantId])
}

enum InventoryChangeType {
  MANUAL
  INVOICE
  ADJUSTMENT
}

model InventoryLedger {
  id Int @id @default(autoincrement())

  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  changeType InventoryChangeType
  delta      Int // + or -
  note       String?

  createdAt DateTime @default(now())

  @@index([inventoryId])
}

enum Currency {
  IRR
  IRT
  USD
  EUR
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InvoiceType {
  INSTANT
  WAREHOUSE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum ReminderChannel {
  SMS
  NOTIF
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELED
}

model Payment {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount                BigInt // minor units, in payment currency
  currency              Currency @default(IRR)
  amountInvoiceCurrency BigInt   @default(0) // amount converted to invoice currency (minor units)

  exchangeRateBase      Currency?
  exchangeRateQuote     Currency?
  exchangeRateValue     BigInt?
  exchangeRateFetchedAt DateTime?

  method PaymentMethod
  status PaymentStatus @default(RECORDED)

  note   String?
  paidAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([paidAt])
}

model ExchangeRate {
  id Int @id @default(autoincrement())

  base  Currency
  quote Currency
  rate  BigInt

  fetchedAt DateTime @default(now())

  @@index([base, quote, fetchedAt])
}

model DiscountCode {
  id Int @id @default(autoincrement())

  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  code  String
  type  DiscountType
  value BigInt

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  maxUses   Int?
  usedCount Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, code])
  @@index([sellerId])
  @@index([variantId])
}

model Invoice {
  id       Int           @id @default(autoincrement())
  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  type   InvoiceType
  status InvoiceStatus @default(ISSUED)

  // Optional linkage to a registered customer
  customerId Int?
  customer   SellerCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshot (supports non-member invoices + preserves history)
  customerName  String?
  customerPhone String?

  discountCodeId Int?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  extra Json?

  currency Currency
  // money in minor units
  subtotal BigInt
  discount BigInt   @default(0)
  tax      BigInt   @default(0)
  total    BigInt

  exchangeRateBase      Currency?
  exchangeRateQuote     Currency?
  exchangeRateValue     BigInt?
  exchangeRateFetchedAt DateTime?

  pdfKey         String?
  pdfToken       String?   @unique
  pdfGeneratedAt DateTime?

  issuedAt DateTime @default(now())

  items     InvoiceItem[]
  payments  Payment[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdByUserId Int
  createdByUser   User @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId])
  @@index([warehouseId])
  @@index([sellerId])
  @@index([customerId])
  @@index([discountCodeId])
  @@index([issuedAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // For warehouse invoices you will set variantId, for instant invoices it can be null
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  description String?
  quantity    Int
  unitPrice   BigInt // minor units
  lineTotal   BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([variantId])
}

model Reminder {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sellerId Int
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  dueAt    DateTime
  remindAt DateTime

  channel ReminderChannel
  status  ReminderStatus  @default(PENDING)

  message String?
  sentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([invoiceId])
  @@index([remindAt])
}

model CustomerAccessToken {
  id Int @id @default(autoincrement())

  phone     String
  tokenHash String
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@unique([tokenHash])
  @@index([phone])
  @@index([expiresAt])
}
